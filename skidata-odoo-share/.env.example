# SharePoint (same app as SKIDATA-Odoo upload; can also load parent ../.env)
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
SHAREPOINT_SITE_NAME=https://yourtenant.sharepoint.com/sites/YourSite
TARGET_FOLDER_PATH=SKIDATA - Odoo

# Odoo (used later for real import; optional for dry-run preview)
ODOO_URL=https://makanparking.odoo.com
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_JOURNAL_ID=1
ODOO_SALES_ACCOUNT_ID=
ODOO_TAX_ID=
ODOO_WALKIN_PARTNER_ID=
ODOO_PAYMENT_JOURNAL_ID=

# Optional: unattended post/pay in main_import.py (default off = draft only)
ODOO_POST=false
ODOO_PAY=false
